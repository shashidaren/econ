# econ dashboard — optional environment overrides
# Copy to /opt/econ/.env on the server if you want to change defaults.
# (The systemd unit in install.sh sets ECON_PORT; edit there or override below.)

ECON_PORT=8080
# ECON_REFRESH=300        # background refresh cadence, seconds
# ECON_DEMO=1             # sample data, no network (preview mode)

# Reserved for the future: a free FRED API key would unlock extra panels
# (register at https://fred.stlouisfed.org/docs/api/api_key.html).
# FRED_API_KEY=
